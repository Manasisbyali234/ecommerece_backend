NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/metromindz
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:3000
# Development only: returns this code from POST /api/v1/auth/request-otp
OTP_DEBUG=true

# Optional production providers. Leave empty to keep external actions disabled.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
RESEND_API_KEY=
EMAIL_FROM=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional carrier integration. Shiprocket is used when CARRIER_PROVIDER=shiprocket.
CARRIER_PROVIDER=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Cloudflare R2 image uploads. R2_PUBLIC_URL must be a public bucket/custom-domain URL.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ecommerce
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://<your-public-r2-domain>
